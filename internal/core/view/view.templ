package view

import (
	"github.com/tashirka1/k2/internal/core/config"
)

templ Nav(cfg config.Config) {
	<nav>
		<ul>
			<li>
				<a href="/" class="contrast">
					<strong>K2</strong>
				</a>
			</li>
			<li>
				<select id="refresh" class="nav-refresh" aria-label="Auto-refresh" title="Auto-refresh">
					<option value="off">Off</option>
					<option value="5s">5s</option>
					<option value="10s">10s</option>
					<option value="30s">30s</option>
					<option value="1m">1m</option>
				</select>
			</li>
			<li>
				<a href="#" aria-label="Config" title="Config" style="font-size: 1.4rem; text-decoration: none; line-height: 1;" onclick="event.preventDefault();document.getElementById('config-modal').showModal()">⚙</a>
			</li>
		</ul>
		<ul class="nav-desktop">
			<li><a href="/metrics/system">System</a></li>
			<li><a href="/metrics/processes">Processes</a></li>
			<li><a href="/metrics/containers">Containers</a></li>
			<li><a href="/logout">Log out</a></li>
		</ul>
		<details class="dropdown nav-mobile">
			<summary>☰</summary>
			<ul>
				<li><a href="/metrics/system">System</a></li>
				<li><a href="/metrics/processes">Processes</a></li>
				<li><a href="/metrics/containers">Containers</a></li>
				<li><a href="/logout">Log out</a></li>
			</ul>
		</details>
	</nav>
	@ConfigModal(cfg)
}

templ NavAnon() {
	<nav>
		<ul>
			<li>
				<a href="/" class="contrast">
					<strong>K2</strong>
				</a>
			</li>
		</ul>
		<ul>
			<li><a href="/login">Login</a></li>
		</ul>
	</nav>
}

templ ConfigModal(cfg config.Config) {
	<dialog id="config-modal" onclick="if(event.target===this)this.close()">
		<article>
			<header>
				<button aria-label="Close" rel="prev" onclick="this.closest('dialog').close()"></button>
				<strong>Config</strong>
			</header>
			<div style="overflow-x: auto">
				<table>
					<thead>
						<tr><th>Key</th><th>Value</th></tr>
					</thead>
					<tbody>
						<tr><td>Port</td><td>{ cfg.Port }</td></tr>
						<tr><td>EnvFile</td><td>{ cfg.EnvFile }</td></tr>
						<tr><td>DBName</td><td>{ cfg.DBName }</td></tr>
						<tr><td>SessionKey</td><td>{ cfg.SessionKey }</td></tr>
						<tr><td>Username</td><td>{ cfg.Username }</td></tr>
						<tr><td>Password</td><td>{ cfg.Password }</td></tr>
						<tr><td>CollectInterval</td><td>{ cfg.CollectInterval.String() }</td></tr>
						<tr><td>Retention</td><td>{ cfg.Retention.String() }</td></tr>
					</tbody>
				</table>
			</div>
			<footer>
				<button onclick="this.closest('dialog').close()">Close</button>
			</footer>
		</article>
	</dialog>
}

templ Base(title string, userId int, cfg config.Config) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self';"/>
			<link rel="icon" type="image/x-icon" href="/static/icon/favicon.ico"/>
			<link rel="icon" href="/static/icon/favicon.svg" type="image/svg+xml"/>
			<link rel="apple-touch-icon" href="/static/icon/favicon.png"/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/static/css/pico@2.min.css"/>
			<link rel="stylesheet" href="/static/css/main.css?v=1"/>
		</head>
		<body style="padding: 0px 30px">
			<div id="main">
				<div class="container">
					if userId != 0 {
						@Nav(cfg)
					} else {
						@NavAnon()
					}
					<main>
						<section>
							{ children... }
						</section>
					</main>
				</div>
			</div>
			<script src="/static/js/htmx.org@2.0.10.min.js?v=1"></script>
			<script src="/static/js/chart.umd.js?v=1"></script>
			<script src="/static/js/main.js?v=1"></script>
		</body>
	</html>
}
